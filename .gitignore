# Secrets and local configuration — never commit these
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

# Local Claude Code settings (agents and skills in .claude/ ARE committed)
.claude/settings.local.json

# Editor and OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
tmp/
.cache/

# The architect extends this at kickoff with stack-specific entries
# (dependency directories, build output, coverage reports).

# Python / uv
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Personal media and models — must live in %LOCALAPPDATA%\AMe, never here
*.wav
*.flac
*.bag
*.npz
*.ply
*.glb
*.onnx
*.pth
*.safetensors

# Bazel
bazel-*
MODULE.bazel.lock
