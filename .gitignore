# Secrets and local configuration — never commit these
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

# Local Claude Code settings (agents and skills in .claude/ ARE committed)
.claude/settings.local.json

# Editor and OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
tmp/
.cache/


# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Personal media and models — must live in %LOCALAPPDATA%\AMe, never here
*.wav
*.flac
*.bag
*.npz
*.ply
*.glb
*.onnx
*.pth
*.safetensors
*.mp4
*.mov
*.avi
*.webm
*.mp3
*.m4a
*.ogg
*.npy
*.pt
*.gguf
*.ckpt
*.pkl
*.sqlite
*.db
# Images only under spike and recording folders (docs and UI may hold images)
**/spikes/**/*.png
**/spikes/**/*.jpg
**/spikes/**/*.jpeg
**/spikes/**/*.bmp
**/recordings/**/*.png
**/recordings/**/*.jpg
**/recordings/**/*.jpeg

# Bazel
bazel-*

# graphify output (generated)
graphify-out/

# Documentation images stay committable, including under docs/spikes
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
