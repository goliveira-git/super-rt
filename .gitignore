# Secrets and local configuration — never commit these
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

# Local Claude Code settings (agents and skills in .claude/ ARE committed)
.claude/settings.local.json

# Editor and OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
tmp/
.cache/

